# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Pagamentos
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token_here

# URLs públicas (necessárias para o Checkout Pro em produção)
# Ambas devem ser domínios públicos, NÃO localhost, para o Mercado Pago aceitar back_urls/notification_url.
WEB_APP_URL=https://seu-dominio-web.com
API_PUBLIC_URL=https://seu-dominio-api.com

# Email SMTP para envio de ingressos
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu-usuario
EMAIL_PASSWORD=sua-senha
EMAIL_FROM="MyPass360 <no-reply@seu-dominio.com>"
